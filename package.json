{
  "name": "badminton-club",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch backend/src/index.ts",
    "dev:web": "vite --config frontend/vite.config.ts --host 0.0.0.0",
    "build": "npm run build:server && npm run build:web",
    "start": "node dist/backend/src/index.js",
    "typecheck": "tsc -p frontend/tsconfig.json --noEmit && tsc -p backend/tsconfig.json --noEmit && tsc -p tests/tsconfig.json --noEmit",
    "test": "tsx backend/scripts/test.ts",
    "db:generate": "prisma generate --config backend/prisma.config.ts",
    "db:migrate": "tsx backend/scripts/migrate.ts",
    "db:seed": "tsx backend/prisma/seed.ts",
    "admin:create": "tsx backend/scripts/create-admin.ts",
    "test:e2e": "playwright test --config tests/playwright.config.ts",
    "build:web": "vite build --config frontend/vite.config.ts",
    "build:server": "npm run db:generate && tsc -p backend/tsconfig.json",
    "format": "prettier --ignore-path .gitignore --write frontend backend/src backend/scripts/*.ts backend/tests backend/prisma/seed.ts backend/*.ts backend/*.json tests deploy/**/*.mjs deploy/**/*.md docs README.md package.json .github/workflows/ci.yml",
    "setup": "tsx backend/scripts/setup.ts",
    "predev": "npm run db:generate && npm run db:migrate",
    "package:reg-ru": "node deploy/reg-ru/package.mjs",
    "db:seed:demo": "tsx backend/prisma/seed-demo.ts"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^6.19.0",
    "@prisma/client": "6.19.0",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.18.2",
    "helmet": "^8.1.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-session": "^1.18.2",
    "@types/node": "^24.0.0",
    "@types/passport": "^1.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "prettier": "^3.9.10",
    "prisma": "6.19.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.2.0"
  },
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0",
    "effect": "^3.20.0"
  }
}
