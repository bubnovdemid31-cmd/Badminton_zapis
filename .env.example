# SQLite file relative to the project root. No database server or password needed.
DATABASE_URL="file:./data/club.db"
# npm run setup generates this value securely and writes it to .env.
SESSION_SECRET="GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
WEB_ORIGIN="http://localhost:5173"
PORT=3001
NODE_ENV=development
# Frontend build: https://api.your-domain.ru (empty uses same-origin /api)
VITE_API_URL=""
# Production behind one trusted reverse proxy (Amvera):
TRUST_PROXY=0
COOKIE_SAME_SITE=lax
