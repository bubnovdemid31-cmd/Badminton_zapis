# Must match the password in DATABASE_URL. Used by local Docker Compose only.
POSTGRES_PASSWORD="CHANGE_ME"
DATABASE_URL="postgresql://badminton:CHANGE_ME@localhost:5432/badminton?schema=public"
SESSION_SECRET="GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
WEB_ORIGIN="http://localhost:5173"
PORT=3001
NODE_ENV=development
# Frontend build: https://api.your-domain.ru (empty uses same-origin /api)
VITE_API_URL=""
# Production behind one trusted reverse proxy (Amvera):
TRUST_PROXY=0
# Needed only for a genuinely cross-site frontend/API. Prefer club.ru + api.club.ru.
COOKIE_SAME_SITE=lax
